# Banco de dados (obrigatorio)
DB_URL=jdbc:postgresql://localhost:5432/financeiro_casal
DB_USER=postgres
DB_PASSWORD=troque-aqui

# Segredo do JWT: gere um valor forte, por exemplo
#   openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio

# Servidor
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tokens
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# Extras
SEED_CATEGORIES=true
RECURRENCE_CRON=0 7 3 * * *
